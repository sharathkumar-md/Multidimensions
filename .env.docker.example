
# Keycloak database password (strong random string, min 32 chars)
KC_DB_PASSWORD=change_me_strong_random_password

# Keycloak admin console password
KEYCLOAK_ADMIN_PASSWORD=change_me_strong_random_password

# NextAuth session signing secret � generate with: openssl rand -base64 32
AUTH_SECRET=change_me_openssl_rand_base64_32

# Keycloak OIDC client credentials (from Keycloak admin console)
KEYCLOAK_CLIENT_ID=rag-sales-bot
KEYCLOAK_CLIENT_SECRET=change_me_client_secret_from_keycloak

# Keycloak issuer URL (defaults to localhost for local dev)
KEYCLOAK_ISSUER=http://localhost:8081/realms/multidimensions
