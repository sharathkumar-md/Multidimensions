# Auto detect text files and perform LF normalization
* text=auto

# Python source files — always LF
*.py text eol=lf
*.pyi text eol=lf

# Config and markup — always LF
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.sh text eol=lf
*.env text eol=lf
*.env.example text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary files — never touch line endings
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pyc binary
*.pkl binary
*.bin binary
*.pt binary
*.pth binary
*.safetensors binary
