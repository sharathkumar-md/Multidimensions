# Copy to .env and adjust. All vars use EVAL_ prefix.

EVAL_OCR_OUTPUT_DIR=../01_ocr/output
EVAL_RESULTS_DIR=results
EVAL_OLLAMA_HOST=http://localhost:11434

# RTX 3050 (4GB): llama3.2:3b fits fully; qwen2.5:7b runs hybrid CPU/GPU
EVAL_MODELS_TO_EVALUATE=["llama3.2:3b","qwen2.5:7b","phi3.5:mini"]

EVAL_LOG_LEVEL=INFO
EVAL_LOG_FILE=logs/eval.log
