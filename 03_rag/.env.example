# ═══════════════════════════════════════════════════════════════════════════════
# MultiDimensions RAG — Environment Variable Reference
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values. The .env file is gitignored.
# In production (GCP Cloud Run), inject these as environment variables or use
# GCP Secret Manager — never commit real secrets to source control.
#
# All variables use the RAG_ prefix.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Core Directories ────────────────────────────────────────────────────────────
# Paths are resolved relative to the 03_rag/ directory unless absolute.
# RAG_OCR_OUTPUT_DIR=../data/ocr_output
# RAG_INDEX_DIR=index
# RAG_RESULTS_DIR=results
# RAG_WEB_CACHE_DIR=.cache/web_search

# ── Generator Model ─────────────────────────────────────────────────────────────
# RAG_GENERATOR_MODEL_ID=Qwen/Qwen3-8B

# ── RAG Parameters ───────────────────────────────────────────────────────────────
# RAG_EMBED_MODEL=BAAI/bge-large-en-v1.5
# RAG_QDRANT_COLLECTION_NAME=rag_chunks
# RAG_TOP_K_DENSE=30
# RAG_TOP_K_SPARSE=30
# RAG_TOP_K_RERANK=8
# RAG_HYDE_ENABLED=true
# RAG_WEB_SEARCH_ENABLED=true
# RAG_WEB_SEARCH_MAX_RESULTS=15
# RAG_WEB_SNIPPET_MAX_CHARS=500
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Rate Limiting ───────────────────────────────────────────────────────────────
# RAG_RATE_LIMIT_PER_MINUTE=20

# ── Logging & Audit ─────────────────────────────────────────────────────────────
# RAG_LOG_LEVEL=INFO
# RAG_LOG_FILE=logs/rag.log
# RAG_AUDIT_LOG_FILE=logs/audit.log

# ── Authentication (Keycloak OIDC) ───────────────────────────────────────────────
# Set RAG_AUTH_ENABLED=false for local development (bypasses auth entirely).
# Set RAG_AUTH_ENABLED=true in production — the values below become REQUIRED.
RAG_AUTH_ENABLED=false

# [REQUIRED in production] Your Keycloak server base URL
# RAG_KEYCLOAK_SERVER_URL=https://auth.yourcompany.com

# [REQUIRED in production] The Keycloak realm for this application
# RAG_KEYCLOAK_REALM=multidimensions

# [REQUIRED in production] The client ID registered in Keycloak
# RAG_KEYCLOAK_CLIENT_ID=rag-sales-bot

# [REQUIRED in production] The client secret from Keycloak — NEVER commit this value
# RAG_KEYCLOAK_CLIENT_SECRET=<generate with: openssl rand -hex 32>

# [REQUIRED in production] Base URL of this Streamlit app (for OAuth redirect)
# RAG_APP_BASE_URL=https://your-app.run.app

# [REQUIRED in production] Signing key for session cookies — NEVER commit this value
# RAG_AUTH_SESSION_KEY=<generate with: openssl rand -hex 32>
