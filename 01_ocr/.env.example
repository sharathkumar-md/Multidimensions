# Copy to .env and adjust. All vars use OCR_ prefix.

OCR_INPUT_DIR=../../data/input
OCR_OUTPUT_DIR=output

OCR_OCR_ENABLED=true
OCR_OCR_LANG=["en"]
OCR_FORCE_FULL_OCR=false

OCR_EXTRACT_TABLES=true
OCR_MIN_TABLE_CELLS=4
OCR_EXTRACT_FIGURES=true
OCR_FIGURE_DPI=150

OCR_STRIP_REPEATED_ELEMENTS=true
OCR_REPEATED_ELEMENT_THRESHOLD=3
OCR_PII_REDACTION_ENABLED=false
OCR_PII_REDACTION_ENTITIES=["PERSON","EMAIL_ADDRESS","PHONE_NUMBER","CREDIT_CARD"]

OCR_MAX_WORKERS=1
OCR_SKIP_DUPLICATES=true

OCR_LOG_LEVEL=INFO
OCR_LOG_FILE=logs/ocr_pipeline.log
OCR_LOG_ROTATION=10 MB
OCR_LOG_RETENTION=30 days
