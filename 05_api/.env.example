# ── API Server ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true                # set false in production
API_LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── Auth ────────────────────────────────────────────────────────────────────
# Defaults to TRUE for production safety. Set false ONLY for local development.
API_AUTH_ENABLED=true
API_KEYCLOAK_SERVER_URL=https://keycloak.example.com
API_KEYCLOAK_REALM=multidimensions
API_KEYCLOAK_CLIENT_ID=rag-sales-bot

# ── Rate Limiting ────────────────────────────────────────────────────────────
API_RATE_LIMIT_PER_MINUTE=20   # 0 = disabled

# ── RAG Pipeline ────────────────────────────────────────────────────────────
# Path to 03_rag directory (auto-detected if running from project root)
# RAG_DIR=../03_rag

# ── Session Store ────────────────────────────────────────────────────────────
# File-based JSON store path (relative to 05_api/)
API_SESSION_STORE_PATH=.sessions.json

# ── Upload ──────────────────────────────────────────────────────────────────
API_UPLOAD_DIR=../data/uploads
API_MAX_UPLOAD_SIZE_MB=50
