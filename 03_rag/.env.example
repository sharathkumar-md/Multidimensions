# Copy to .env and adjust. All vars use RAG_ prefix.

RAG_OCR_OUTPUT_DIR=../data/ocr_output
RAG_INDEX_DIR=index
RAG_RESULTS_DIR=results

RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100

RAG_EMBED_MODEL=BAAI/bge-m3
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_TOP_K_RERANK=5
RAG_HYDE_ENABLED=true

RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_NLI_MODEL=cross-encoder/nli-deberta-v3-small

RAG_LOG_LEVEL=INFO
RAG_LOG_FILE=logs/rag.log
