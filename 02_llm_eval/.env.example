# Copy to .env and adjust. All vars prefixed with EVAL_ (pydantic-settings env_prefix).

# Path to 01_ocr pipeline output (contains manifests/ and markdown/ subdirs)
EVAL_OCR_OUTPUT_DIR=../01_ocr/output

# Where to write eval results (JSON + CSV)
EVAL_RESULTS_DIR=results

# Ollama server URL (default: local; change to VPC endpoint in production)
EVAL_OLLAMA_HOST=http://localhost:11434

# Models to evaluate — must be pulled in Ollama first
# RTX 3050 (4GB): llama3.2:3b fits fully; qwen2.5:7b runs hybrid CPU/GPU
EVAL_MODELS_TO_EVALUATE=["llama3.2:3b","qwen2.5:7b","phi3.5:mini"]

# Logging
EVAL_LOG_LEVEL=INFO
EVAL_LOG_FILE=logs/eval.log
